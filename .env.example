# Local development only. Do not reuse these values in production.
POSTGRES_USER=swap_chain
POSTGRES_PASSWORD=swap_chain
POSTGRES_DB=swap_chain
POSTGRES_PORT=5432

# Used when backend and migrations run directly on the host.
DATABASE_URL=postgres://swap_chain:swap_chain@127.0.0.1:5432/swap_chain?sslmode=disable
MIGRATIONS_URL=file://migrations
BACKEND_PORT=8080
HTTP_ADDR=:8080
DB_CONNECT_TIMEOUT=10s
SHUTDOWN_TIMEOUT=10s

MATCHING_SIMILAR_ITEMS=20
MATCHING_CHAIN_LENGTH=4
MATCHING_PENALTY_FACTOR=0.25
MATCHING_CHAIN_THRESHOLD=0.30

SWAGGER_PORT=8081
