# Local development only. Do not reuse these values in production.
POSTGRES_USER=swap_chain
POSTGRES_PASSWORD=swap_chain
POSTGRES_DB=swap_chain
POSTGRES_PORT=5432

# Used when backend and migrations run directly on the host.
DATABASE_URL=postgres://swap_chain:swap_chain@127.0.0.1:5432/swap_chain?sslmode=disable
MIGRATIONS_URL=file://migrations
BACKEND_PORT=8080
FRONTEND_PORT=18080
HTTP_ADDR=:8080
DB_CONNECT_TIMEOUT=10s
SHUTDOWN_TIMEOUT=10s

# CORS and session
CORS_ALLOWED_ORIGIN=http://localhost:18080
SESSION_TTL=24h
COOKIE_SECURE=false

# Ollama (host by default for GPU; use profile "ollama" in compose for CPU-only container)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDINGS_MODEL=bge-m3

# MinIO (in-container)
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=swap-chain-media

MEDIA_MAX_UPLOAD_BYTES=10485760

MATCHING_SIMILAR_ITEMS=20
MATCHING_CHAIN_LENGTH=3
MATCHING_PENALTY_FACTOR=0.25
MATCHING_CHAIN_THRESHOLD=0.30
MATCHING_COMPATIBILITY_THRESHOLD=0.50

ANALYSIS_CATEGORY_SIMILARITY_THRESHOLD=0.65
ANALYSIS_CATEGORY_CONFIDENCE_MARGIN=0.05
ANALYSIS_RECOVERY_POLL_INTERVAL=30s
ANALYSIS_STALE_AFTER=5m
ANALYSIS_RECOVERY_BATCH_SIZE=100

SWAGGER_PORT=8081
