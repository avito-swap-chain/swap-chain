# Local development only. Do not reuse these values in production.
POSTGRES_USER=swap_chain
POSTGRES_PASSWORD=swap_chain
POSTGRES_DB=swap_chain
POSTGRES_PORT=5432

# Used when backend and migrations run directly on the host.
DATABASE_URL=postgres://swap_chain:swap_chain@127.0.0.1:5432/swap_chain?sslmode=disable
MIGRATIONS_URL=file://migrations
BACKEND_PORT=8080
FRONTEND_PORT=18080
HTTP_ADDR=:8080
DB_CONNECT_TIMEOUT=10s
SHUTDOWN_TIMEOUT=10s

# CORS and session
CORS_ALLOWED_ORIGIN=http://localhost:18080
SESSION_TTL=24h
COOKIE_SECURE=false

# Ollama (in-container by default)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDINGS_MODEL=bge-m3
OLLAMA_TIMEOUT=4m

# MinIO (in-container)
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=swap-chain-media

MEDIA_MAX_UPLOAD_BYTES=10485760

# ==========================================
# МОДУЛЬ MATCHING (Поиск цепочек обменов)
# ==========================================
# Количество похожих вещей для первоначального поиска кандидатов в графе
MATCHING_SIMILAR_ITEMS=20
# Максимальная длина цепочки обмена (например, 3 означает A -> B -> C -> A)
MATCHING_CHAIN_LENGTH=3
# Штрафной коэффициент для длинных цепочек при расчете скора
MATCHING_PENALTY_FACTOR=0.25
# Порог совместимости для всей цепочки (отклоняются цепочки с итоговым скором ниже этого порога)
MATCHING_CHAIN_THRESHOLD=0.30
# Базовый порог совместимости между двумя конкретными вещами
MATCHING_COMPATIBILITY_THRESHOLD=0.4
# Порог совместимости, если категория одной из вещей неизвестна
MATCHING_UNDEFINED_COMPATIBILITY_THRESHOLD=0.5
# Включение режима отладки для матчинга (дополнительное логирование алгоритма)
MATCHING_DEBUG=true
# ID категории "Неизвестно/Другое" (в случае, если нейросеть не смогла определить категорию)
UNDEFINED_CATEGORY_ID=47

# ==========================================
# МОДУЛЬ ANALYZE (Нейросетевой анализ вещей)
# ==========================================
# Минимальный порог косинусного сходства векторов для уверенного определения категории вещи
ANALYSIS_CATEGORY_SIMILARITY_THRESHOLD=0.3
# Маржа уверенности (минимальная разница между лучшим и вторым лучшим совпадением категории)
ANALYSIS_CATEGORY_CONFIDENCE_MARGIN=0.01
# Интервал опроса базы данных воркером для восстановления зависших задач анализа
ANALYSIS_RECOVERY_POLL_INTERVAL=30s
# Максимальное время (таймаут) на одну задачу анализа вещи
ANALYSIS_TIMEOUT=5m
# Время, после которого задача анализа считается зависшей и подлежит перезапуску воркером
ANALYSIS_STALE_AFTER=6m
# Количество задач анализа, которые обрабатываются за один цикл восстановления воркером
ANALYSIS_RECOVERY_BATCH_SIZE=100
# Количество одновременно выполняемых горутин (задач) в рамках одного анализа (параллелизм)
ANALYSIS_CONCURRENCY=3

# ==========================================
# МОДУЛЬ CHAT (Обмен сообщениями)
# ==========================================
# Максимальное количество сообщений, возвращаемых за один запрос (пагинация списка)
CHAT_MAX_LIST_LIMIT=100
# Максимальное время ожидания новых сообщений сервером (используется для Long Polling)
CHAT_MAX_WAIT=25s

# ==========================================
# МОДУЛЬ ADMIN (Управление доставками)
# ==========================================
# Максимальное количество доставок, возвращаемых за один запрос (пагинация списка)
ADMIN_MAX_LIST_LIMIT=100

SWAGGER_PORT=8081
GIGACHAT_AUTH_KEY=
